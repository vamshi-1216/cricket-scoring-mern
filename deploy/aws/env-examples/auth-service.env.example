# Production .env for services/auth-service (written by setup-ec2.sh)
NODE_ENV=production
PORT=4001
FRONTEND_ORIGIN=http://<PUBLIC_IP_OR_DOMAIN>
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
JWT_SECRET=<64 hex chars, openssl rand -hex 32>
JWT_EXPIRES_IN=15m
GOOGLE_CLIENT_ID=<same as VITE_GOOGLE_CLIENT_ID in the frontend build>
MSG91_AUTH_KEY=<your msg91 auth key>
INTERNAL_SERVICE_SECRET=<64 hex chars, openssl rand -hex 32>

# Email: all three or none
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=
