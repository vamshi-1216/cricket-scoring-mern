# frontend/.env.production (written by setup-ec2.sh before `vite build`;
# values are baked into the JS bundle at build time)
VITE_API_URL=http://<PUBLIC_IP_OR_DOMAIN>/api/v1/auth
VITE_PLAYER_API_URL=http://<PUBLIC_IP_OR_DOMAIN>/api/v1/players
VITE_TEAM_API_URL=http://<PUBLIC_IP_OR_DOMAIN>/api/v1/teams
# VITE_MATCH_API_URL=http://<PUBLIC_IP_OR_DOMAIN>/api/v1/matches
# VITE_SCORING_API_URL=http://<PUBLIC_IP_OR_DOMAIN>
VITE_GOOGLE_CLIENT_ID=<same as auth-service GOOGLE_CLIENT_ID>
VITE_MSG91_WIDGET_ID=<your msg91 widget id>
VITE_MSG91_TOKEN_AUTH=<your msg91 token auth>
