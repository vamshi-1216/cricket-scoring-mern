
# Application
NODE_ENV=development
PORT=4001
FRONTEND_ORIGIN=http://localhost:5173

# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/cricket_auth

# JWT authentication
JWT_SECRET=sample_secret_change_this_to_a_random_value_12345
JWT_EXPIRES_IN=15m

# Google Sign-In
GOOGLE_CLIENT_ID=sample_google_client_id

# MSG91 phone verification
MSG91_AUTH_KEY=sample_msg91_auth_key

# Email configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM=your_email@example.com
